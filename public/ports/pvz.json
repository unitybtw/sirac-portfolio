{"html": "\u003c!-- Entry adapter from https://github.com/web-ports/pvz. Game runtime/assets remain upstream. -->\n\u003c!doctype html>\n\u003chtml>\n\u003cbody>\n  \u003cbase href=\"https://cdn.jsdelivr.net/gh/web-ports/pvz@e3b5ddce5a318df69698d906a6d78313e327f965/\">\n  \u003cstyle>\n    #loading-text {\n  font-weight: bold;\n  background: linear-gradient(\n    270deg,\n    #ff0000,\n    #ff7f00,\n    #ffff00,\n    #00ff00,\n    #0000ff,\n    #4b0082,\n    #8f00ff\n  );\n  background-size: 400% 400%;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  animation: rainbow 3s ease infinite;\n}\n\n@keyframes rainbow {\n  0% { background-position: 0% 50%; }\n  50% { background-position: 100% 50%; }\n  100% { background-position: 0% 50%; }\n}\n  \u003c/style>\n\u003cdiv id=\"loading-text\"\n    style=\"color: white; font-size: 48px; font-family: cursive; text-align: center; margin-top: 20px;\"> LOADING...\n  \u003c/div>\n\u003ccanvas id=\"canvas\" width=\"800\" height=\"600\" style=\"display:block; outline:0\">\u003c/canvas>\n\n\u003ctextarea\n  id=\"pvz-soft-keyboard\"\n  style=\"position:fixed; top:0; left:0; width:1px; height:1px; opacity:0; pointer-events:none; font-size:16px\"\n  autocapitalize=\"off\"\n  autocomplete=\"off\"\n  autocorrect=\"off\"\n  enterkeyhint=\"done\"\n  spellcheck=\"false\"\n>\u003c/textarea>\n\n\u003cscript>\n  let _res, _rej;\n  window.moduleReadyPromise = new Promise((r, e) => { _res = r; _rej = e; });\n\n  var Module = {\n    canvas: document.getElementById(\"canvas\"),\n    noInitialRun: true,\n    onRuntimeInitialized: _res,\n    onAbort: e => _rej(e),\n    print: console.log,\n    printErr: console.warn,\n  };\n\u003c/script>\n\n\u003cscript>\nvar loadingText = document.querySelector(\"#loading-text\");\n    let totalBytes = 0;\n    let loadedBytes = 0;\n\n    async function fetchWithProgress(url) {\n      const response = await fetch(url);\n      const reader = response.body.getReader();\n      let chunks = [];\n      let received = 0;\n      while (true) {\n        const {\n          done,\n          value\n        } = await reader.read();\n        if (done) break;\n        received += value.length;\n        loadedBytes += value.length;\n        chunks.push(value);\n        let mbDone = (loadedBytes / (1024 * 1024)).toFixed(2);\n        let mbTotal = '43.34';\n        loadingText.textContent = `LOADING... ${mbDone} MB / ${mbTotal} MB`;\n      }\n      let fullBuffer = new Uint8Array(received);\n      let offset = 0;\n      for (let chunk of chunks) {\n        fullBuffer.set(chunk, offset);\n        offset += chunk.length;\n      }\n      return fullBuffer.buffer;\n    }\n\n    async function mergeFiles(fileParts, cacheKey) {\n      const buffers = await Promise.all(\n        fileParts.map(part => fetchWithProgress(part))\n      );\n      const mergedBlob = new Blob(buffers);\n      return URL.createObjectURL(mergedBlob);\n    }\n\n    function getParts(file, start, end) {\n      let parts = [];\n      for (let i = start; i \u003c= end; i++) {\n        parts.push(file + \".part\" + i);\n      }\n      return parts;\n    }\n    (async () => {\n      const [pakurl] = await Promise.all([\n        mergeFiles(getParts(\"main.pak\", 1, 3), \"main.pak\"),\n      ]);\n      let ns = document.createElement(\"script\");\n      ns.src=\"pvz.js\";\n      document.body.appendChild(ns);\n    await moduleReadyPromise;\n\n    const files = [\n      [pakurl, \"main.pak\"],\n      [\"properties/Layout.xml\", \"properties/Layout.xml\"],\n      [\"properties/partner.xml.sig\", \"properties/partner.xml.sig\"],\n      [\"properties/default.xml\", \"properties/default.xml\"],\n      [\"properties/partner.xml\", \"properties/partner.xml\"],\n      [\"properties/partner_logo.jpg\", \"properties/partner_logo.jpg\"],\n    ];\n\n    for (const [src, dest] of files) {\n      const data = new Uint8Array(await (await fetch(src)).arrayBuffer());\n      const parts = dest.split(\"/\");\n      let dir = \"/\";\n      for (let i = 0; i \u003c parts.length - 1; i++) {\n        dir += (dir === \"/\" ? \"\" : \"/\") + parts[i];\n        try { Module.FS.mkdir(dir); } catch {}\n      }\n      Module.FS.writeFile(\"/\" + dest, data);\n    }\n\n    try { Module.FS.mkdir(\"/saves\"); } catch {}\n    try { Module.FS.mount(Module.FS.filesystems.IDBFS, {}, \"/saves\"); } catch {}\n    await new Promise(r => Module.FS.syncfs(true, r));\n\n    const c = document.getElementById(\"canvas\");\n    const resize = () => {\n      const s = Math.min(innerWidth / 800, innerHeight / 600);\n      c.style.width  = s * 800 + \"px\";\n      c.style.height = s * 600 + \"px\";\n    };\n    resize();\n    addEventListener(\"resize\", resize);\n    addEventListener(\"fullscreenchange\", resize);\n\n    document.body.style = \"margin:0; background:#000; display:flex; justify-content:center; align-items:center; height:100vh; overflow:hidden\";\n\n    const sync = () => Module.FS.syncfs(false, () => {});\n    setInterval(sync, 5000);\n    addEventListener(\"visibilitychange\", () => document.hidden && sync());\n    addEventListener(\"pagehide\", sync);\n\n    Module.callMain([]);\n    loadingText.remove();\n  })();\n\u003c/script>\n\n\u003c/body>\n\u003c/html>\n\n\u003cscript>\nwindow.addEventListener('unhandledrejection', () => {\n  const message = document.createElement('p');\n  message.textContent = 'Game could not load. Check your connection and use Restart to try again.';\n  message.style.cssText = 'position:fixed;bottom:12px;left:12px;right:12px;padding:12px;background:#fff;color:#222;font:14px sans-serif;z-index:99999';\n  document.body.appendChild(message);\n}, {once:true});\n\u003c/script>\n\u003cstyle>\nhtml, body { margin:0; background:#111; }\n#loading-text, #loading-textt { position:fixed; inset:0; margin:0 !important; display:grid; place-content:center; padding:24px; font:16px/1.5 system-ui !important; color:#fff !important; background:#111 !important; -webkit-text-fill-color:#fff !important; -webkit-text-stroke:0 !important; animation:none !important; z-index:5; }\n\u003c/style>"}