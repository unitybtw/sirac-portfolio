{"html": "\u003c!-- Entry adapter from https://github.com/web-ports/slime-ranchers. Game runtime/assets remain upstream. -->\n\u003c!--\nfull credit snubby.top\ni just edited it a bit to make it better for gn-math\n-->\n\n\u003c!DOCTYPE html>\n\u003chtml lang=\"en-us\">\n\n\u003chead>\n    \u003cbase href=\"https://cdn.jsdelivr.net/gh/web-ports/slime-ranchers@f0c5856ac43cf0cfbab4c58139282fc75f9b1861/\">\n    \u003cmeta charset=\"utf-8\">\n    \u003ctitle>Slime Rancher Decompiled v0.2.1\u003c/title>\n    \u003clink rel=\"shortcut icon\" href=\"TemplateData/favicon.ico\">\n    \u003clink rel=\"stylesheet\" href=\"TemplateData/style.css\">\n    \u003cscript type=\"text/javascript\" src=\"https://ajax.googleapis.com/ajax/libs/jquery/1.6.0/jquery.min.js\">\u003c/script>\n    \u003cscript src=\"TemplateData/UnityProgress.js\">\u003c/script>\n    \u003cscript src=\"Build/UnityLoader.js\">\u003c/script>\n    \u003cscript src=\"mobile-controls.js\">\u003c/script>\n    \u003clink href=\"https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap\" rel=\"stylesheet\">\n\u003c/head>\n\n\u003cbody>\n    \u003cdiv class=\"webgl-content\">\n        \u003cdiv class=\"bg\">\n            \u003cimg class=\"bg\" src=\"TemplateData/loading_bg.png\" style=\"width: 100%; height: 100%; padding: 0px; margin: 0px; border: 0px; position: absolute;\">\n        \u003c/div>\n        \u003cdiv id=\"loading-text\" style=\"-webkit-text-stroke-width: 2px; -webkit-text-stroke-color: black; color: white; font-size: 48px; font-family: cursive; text-align: center; margin-top: 20px;\">LOADING...\u003c/div>\n        \u003cdiv id=\"gameContainer\" style=\"width: 960px; height: 600px\">\u003c/div>\n    \u003c/div>\n    \u003cscript src=\"TemplateData/responsive.js\">\u003c/script>\n\u003c/body>\n\u003cscript>\n\n    const ogxhr = window.XMLHttpRequest;\n\n    function xhrfunc() {\n        const xhr = new ogxhr();\n        const open = xhr.open;\n        xhr.open = function(method, url, ...rest) {\n            if (url.includes(\"blob:\")) {\n                return open.call(this, method, \"blob:\"+url.split(\"blob:\")[1], ...rest);\n            }\n            return open.call(this, method, url, ...rest);\n        };\n        return xhr;\n    }\n    window.XMLHttpRequest = xhrfunc;\n\n    var loadingText = document.querySelector(\"#loading-text\");\n\n    let loadedBytes = 0;\n\n    async function fetchWithProgress(url) {\n        const response = await fetch(url);\n        const reader = response.body.getReader();\n        let chunks = [];\n        let received = 0;\n\n        while (true) {\n            const {\n                done,\n                value\n            } = await reader.read();\n            if (done) break;\n            received += value.length;\n            loadedBytes += value.length;\n            chunks.push(value);\n\n            let mbDone = (loadedBytes / (1024 * 1024)).toFixed(2);\n            let mbTotal = '54.5';\n            loadingText.innerHTML = `LOADING... ${mbDone} MB / ${mbTotal} MB`;\n        }\n\n        let fullBuffer = new Uint8Array(received);\n        let offset = 0;\n        for (let chunk of chunks) {\n            fullBuffer.set(chunk, offset);\n            offset += chunk.length;\n        }\n        return fullBuffer.buffer;\n    }\n\n    async function mergeFiles(fileParts) {\n        const buffers = await Promise.all(fileParts.map(part => fetchWithProgress(part)));\n        const mergedBlob = new Blob(buffers);\n        return URL.createObjectURL(mergedBlob);\n    }\n\n    function getParts(file, start, end) {\n        let parts = [];\n        for (let i = start; i \u003c= end; i++) {\n            parts.push(file + \".part\" + i);\n        }\n        return parts;\n    }\n\n    function resizeUnityContainer() {\n        var container = document.getElementById(\"gameContainer\");\n        var canvas = container.querySelector(\"canvas\");\n\n        container.style.width = window.innerWidth + \"px\";\n        container.style.height = window.innerHeight + \"px\";\n\n        if (canvas) {\n            canvas.style.width = window.innerWidth + \"px\";\n            canvas.style.height = window.innerHeight + \"px\";\n        }\n    }\n\n\n    (async () => {\n        const [dataUrl] = await Promise.all([\n            mergeFiles(getParts(\"Build/slimeBUILDS.data.unityweb\", 1, 3)),\n        ]);\n\n        const json = {\n            \"companyName\": \"Snubs\",\n            \"productName\": \"Slime Rancher Prototype\",\n            \"dataUrl\": dataUrl,\n            \"wasmCodeUrl\": \"slimeBUILDS.wasm.code.unityweb\",\n            \"wasmFrameworkUrl\": \"slimeBUILDS.framework.unityweb\",\n            \"TOTAL_MEMORY\": 536870912,\n            \"graphicsAPI\": [\"WebGL 2.0\", \"WebGL 1.0\"],\n            \"webglContextAttributes\": {\n                \"preserveDrawingBuffer\": false\n            },\n            \"splashScreenStyle\": \"Dark\"\n        };\n\n        let blob = new Blob([JSON.stringify(json)], {\n            type: \"application/json\"\n        });\n        let blobUrl = URL.createObjectURL(blob);\n        window.addEventListener(\"resize\", resizeUnityContainer);\n\n        UnityLoader.instantiate(\"gameContainer\", json, {\n            url: blobUrl,\n            Module: {\n                onRuntimeInitialized: function() {\n                    resizeUnityContainer();\n                    document.querySelector(\"#loading-text\").remove();\n                },\n            },\n        });\n    })();\n\u003c/script>\n\n\u003c/html>\n\u003cscript>\nwindow.addEventListener('unhandledrejection', () => {\n  const message = document.createElement('p');\n  message.textContent = 'Game could not load. Check your connection and use Restart to try again.';\n  message.style.cssText = 'position:fixed;bottom:12px;left:12px;right:12px;padding:12px;background:#fff;color:#222;font:14px sans-serif;z-index:99999';\n  document.body.appendChild(message);\n}, {once:true});\n\u003c/script>\n\u003cstyle>\nhtml, body { margin:0; background:#111; }\n#loading-text, #loading-textt { position:fixed; inset:0; margin:0 !important; display:grid; place-content:center; padding:24px; font:16px/1.5 system-ui !important; color:#fff !important; background:#111 !important; -webkit-text-fill-color:#fff !important; -webkit-text-stroke:0 !important; animation:none !important; z-index:5; }\n\u003c/style>"}