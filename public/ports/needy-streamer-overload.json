{"html": "\u003c!-- Entry adapter from https://github.com/web-ports/needy-streamer-overload. Game runtime and assets remain upstream. -->\n\u003c!DOCTYPE html>\n\u003chtml lang=\"en-us\">\n\n\u003chead>\n\u003cscript>// Sandboxed game runtimes use session-only storage, never the portfolio's storage.\n// These adapters implement the standard APIs without granting origin access.\n(() => {\n  const memoryStorage = () => {\n    const entries = new Map();\n    return {\n      get length() { return entries.size; },\n      key(index) { return [...entries.keys()][index] ?? null; },\n      getItem(key) { return entries.get(String(key)) ?? null; },\n      setItem(key, value) { entries.set(String(key), String(value)); },\n      removeItem(key) { entries.delete(String(key)); },\n      clear() { entries.clear(); },\n    };\n  };\n  for (const name of ['localStorage', 'sessionStorage']) {\n    try { void window[name]; }\n    catch { Object.defineProperty(window, name, { value: memoryStorage() }); }\n  }\n  try { void window.caches; }\n  catch {\n    const stores = new Map();\n    const keyOf = (request) => new URL(typeof request === 'string' ? request : request.url, document.baseURI).href;\n    Object.defineProperty(window, 'caches', { value: {\n      async open(name) {\n        if (!stores.has(name)) {\n          const entries = new Map();\n          stores.set(name, {\n            async match(request) { return entries.get(keyOf(request))?.clone(); },\n            async put(request, response) { entries.set(keyOf(request), response.clone()); },\n            async delete(request) { return entries.delete(keyOf(request)); },\n            async keys() { return [...entries.keys()].map(url => new Request(url)); },\n          });\n        }\n        return stores.get(name);\n      },\n      async match(request) {\n        for (const cache of stores.values()) {\n          const response = await cache.match(request);\n          if (response) return response;\n        }\n      },\n      async delete(name) { return stores.delete(name); },\n      async keys() { return [...stores.keys()]; },\n    } });\n  }\n})();\n\u003c/script>\n    \u003cbase href=\"https://cdn.jsdelivr.net/gh/web-ports/needy-streamer-overload@59681566ec4e499caf20511e288aeb26c27daa08/\">\n    \u003cmeta charset=\"utf-8\">\n    \u003cmeta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n    \u003ctitle>Windose\u003c/title>\n    \u003clink rel=\"shortcut icon\" href=\"TemplateData/favicon.ico\">\n    \u003clink rel=\"stylesheet\" href=\"TemplateData/style.css\">\n    \u003cstyle>\n        :root {\n            --edurocks-pink: #EB458B;\n            --edurocks-pink-dark: #BB1C76;\n            --edurocks-bg: #120b12;\n            --edurocks-surface: #1f1421;\n        }\n\n        html,\n        body {\n            width: 100%;\n            height: 100%;\n            margin: 0;\n            padding: 0;\n            overflow: hidden;\n            background: var(--edurocks-bg);\n        }\n\n        body {\n            background: var(--edurocks-bg);\n        }\n\n        #unity-container {\n            background: var(--edurocks-bg);\n            box-shadow: none;\n            position: fixed !important;\n            inset: 0 !important;\n            width: 100%;\n            height: 100%;\n            transform: none !important;\n            padding: 0;\n            box-sizing: border-box;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        #unity-canvas {\n            border: none;\n            box-shadow: none;\n            outline: none;\n            background: transparent;\n            width: 100%;\n            height: 100%;\n            display: block;\n        }\n\n        #unity-loading-bar {\n            background: transparent;\n            z-index: 3;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: absolute;\n            inset: 0;\n            left: 0;\n            top: 0;\n            right: 0;\n            bottom: 0;\n            width: 100%;\n            height: 100%;\n            transform: none !important;\n            margin: 0 !important;\n            pointer-events: none;\n        }\n\n        #unity-loading-bar.hidden {\n            display: none !important;\n        }\n\n        #unity-container.unity-desktop {\n            left: 0 !important;\n            top: 0 !important;\n            transform: none !important;\n        }\n\n        #unity-logo {\n            display: none;\n        }\n\n        #unity-progress-bar-empty {\n            width: min(420px, 80vw);\n            height: 8px;\n            border-radius: 999px;\n            background: rgba(255, 255, 255, 0.18) !important;\n            background-image: none !important;\n            overflow: hidden;\n            display: block;\n            position: relative;\n            margin: 0 !important;\n            margin-left: 0 !important;\n        }\n\n        #unity-progress-bar-full {\n            height: 100%;\n            width: 0%;\n            border-radius: inherit;\n            background: linear-gradient(90deg, var(--edurocks-pink), var(--edurocks-pink-dark)) !important;\n            background-image: none !important;\n            display: block;\n            position: relative;\n            will-change: transform, width;\n            transition: width 0.12s ease;\n            background-size: 200% 100%;\n            animation: progressShimmer 1.2s linear infinite;\n            margin: 0 !important;\n        }\n\n        #unity-progress-bar-full.indeterminate {\n            width: 40%;\n            position: absolute;\n            left: 0;\n            top: 0;\n            animation: indeterminateMove 1.4s ease-in-out infinite !important;\n        }\n\n        @keyframes indeterminateMove {\n            0% {\n                transform: translateX(-120%);\n            }\n\n            50% {\n                transform: translateX(40%);\n            }\n\n            100% {\n                transform: translateX(220%);\n            }\n        }\n\n        @keyframes progressShimmer {\n            0% {\n                background-position: 0% 50%;\n            }\n\n            100% {\n                background-position: 200% 50%;\n            }\n        }\n\n        #unity-canvas:fullscreen,\n        #unity-canvas:-webkit-full-screen,\n        #unity-canvas:-moz-full-screen,\n        #unity-canvas:-ms-fullscreen {\n            margin: 0;\n            height: 100%;\n            width: 100%;\n            display: block;\n        }\n\n        #edurocks-splash {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            gap: 12px;\n            color: #f9f3f7;\n            text-align: center;\n            font-family: \"Segoe UI\", Tahoma, Arial, sans-serif;\n            margin: 0;\n        }\n\n        .edurocks-logo {\n            width: clamp(96px, 20vw, 160px);\n            height: auto;\n            display: block;\n            margin-bottom: 4px;\n        }\n\n        .edurocks-title {\n            font-size: 28px;\n            font-weight: 700;\n            letter-spacing: 0.5px;\n        }\n\n        .edurocks-subtitle {\n            font-size: 14px;\n            color: rgba(255, 255, 255, 0.7);\n        }\n\n        #unity-warning {\n            color: #ffffff;\n        }\n    \u003c/style>\n\u003c/head>\n\n\u003cbody>\n    \u003cdiv id=\"unity-container\" class=\"unity-desktop\">\n        \u003ccanvas id=\"unity-canvas\" width=1280 height=720 tabindex=\"-1\">\u003c/canvas>\n        \u003cdiv id=\"unity-loading-bar\">\n            \u003cdiv id=\"edurocks-splash\">\n                \u003cimg src=\"image.png\" alt=\"EDUrocks\" class=\"edurocks-logo\">\n                \u003cdiv class=\"edurocks-title\">An EDUrocks Group Port\u003c/div>\n                \u003cdiv class=\"edurocks-subtitle\">Loading Needy Streamer Overload...\u003c/div>\n                \u003cdiv id=\"unity-progress-bar-empty\">\n                    \u003cdiv id=\"unity-progress-bar-full\">\u003c/div>\n                \u003c/div>\n            \u003c/div>\n        \u003c/div>\n        \u003cdiv id=\"unity-warning\"> \u003c/div>\n    \u003c/div>\n    \u003cscript>\n        var loadingText = document.querySelector(\".edurocks-subtitle\");\n        let totalBytes = 0;\n        let loadedBytes = 0;\n\n        async function fetchWithProgress(url) {\n            const response = await fetch(url);\n            const reader = response.body.getReader();\n            let chunks = [];\n            let received = 0;\n            while (true) {\n                const {\n                    done,\n                    value\n                } = await reader.read();\n                if (done) break;\n                received += value.length;\n                loadedBytes += value.length;\n                chunks.push(value);\n                let mbDone = (loadedBytes / (1024 * 1024)).toFixed(2);\n                let mbTotal = '407.85';\n                loadingText.textContent = `LOADING... ${mbDone} MB / ${mbTotal} MB`;\n            }\n            let fullBuffer = new Uint8Array(received);\n            let offset = 0;\n            for (let chunk of chunks) {\n                fullBuffer.set(chunk, offset);\n                offset += chunk.length;\n            }\n            return fullBuffer.buffer;\n        }\n        async function mergeFiles(fileParts, cacheKey) {\n            const buffers = await Promise.all(\n                fileParts.map(part => fetchWithProgress(part))\n            );\n            const mergedBlob = new Blob(buffers);\n            return URL.createObjectURL(mergedBlob);\n        }\n\n        function getParts(file, start, end) {\n            let parts = [];\n            for (let i = start; i \u003c= end; i++) {\n                parts.push(file + \".part\" + i);\n            }\n            return parts;\n        }\n        (async () => {\n            const [dataUrl, randombundle] = await Promise.all([\n                mergeFiles(getParts(\"Build/nsoweather2.data.unityweb\", 1, 18), \"nsoweather2.data.unityweb\"),\n                mergeFiles(getParts(\"StreamingAssets/aa/WebGL/8229333135472637d0c8686ab331006d_ef7237aa9eb549052053aced3806fcb4.bundle_assets_all_ef7237aa9eb549052053aced3806fcb4.bundle\", 1, 3), \"8229333135472637d0c8686ab331006d_ef7237aa9eb549052053aced3806fcb4.bundle_assets_all_ef7237aa9eb549052053aced3806fcb4.bundle\"),\n            ]);\n\n            window.randombundle = randombundle;\n            const originalFetch = window.fetch;\n            window.fetch = async function(input, init) {\n                let urlString;\n\n                if (input instanceof Request) {\n                    urlString = input.url;\n                } else {\n                    urlString = String(input);\n                }\n\n                if (urlString.includes(\"8229333135472637d0c8686ab331006d_ef7237aa9eb549052053aced3806fcb4.bundle_assets_all_ef7237aa9eb549052053aced3806fcb4.bundle\")) {\n                    if (input instanceof Request) {\n                        input = new Request(window.randombundle, input);\n                    } else {\n                        input = window.randombundle;\n                    }\n                } else if (urlString.includes(\"StreamingAssets\")){\n                    if (input instanceof Request) {\n                        input = new Request(\"StreamingAssets/\"+urlString.split(\"StreamingAssets/\")[1], input);\n                    } else {\n                        input = \"StreamingAssets/\"+urlString.split(\"StreamingAssets/\")[1];\n                    }\n                }\n\n                return originalFetch(input, init);\n            };\n\n            const originalOpen = XMLHttpRequest.prototype.open;\n            XMLHttpRequest.prototype.open = function(method, url, ...rest) {\n                if (url.includes(\"8229333135472637d0c8686ab331006d_ef7237aa9eb549052053aced3806fcb4.bundle_assets_all_ef7237aa9eb549052053aced3806fcb4.bundle\")) {\n                    url = window.randombundle;\n                } else if (url.includes(\"StreamingAssets\")){\n                    url = \"StreamingAssets/\"+url.split(\"StreamingAssets/\")[1];\n                }\n                return originalOpen.call(this, method, url, ...rest);\n            };\n            var container = document.querySelector(\"#unity-container\");\n            var canvas = document.querySelector(\"#unity-canvas\");\n            var loadingBar = document.querySelector(\"#unity-loading-bar\");\n            var progressBarFull = document.querySelector(\"#unity-progress-bar-full\");\n            var warningBanner = document.querySelector(\"#unity-warning\");\n\n            // Shows a temporary message banner/ribbon for a few seconds, or\n            // a permanent error message on top of the canvas if type=='error'.\n            // If type=='warning', a yellow highlight color is used.\n            // Modify or remove this function to customize the visually presented\n            // way that non-critical warnings and error messages are presented to the\n            // user.\n            function unityShowBanner(msg, type) {\n\n            }\n\n            var buildUrl = \"Build\";\n            var loaderUrl = buildUrl + \"/nsoweather2.loader.js\";\n            var config = {\n                dataUrl: dataUrl,\n                frameworkUrl: buildUrl + \"/framework.js\",\n                codeUrl: buildUrl + \"/nsoweather2.wasm.unityweb\",\n                streamingAssetsUrl: new URL(\"StreamingAssets\", document.baseURI).href,\n                companyName: \"WSS playground\",\n                productName: \"Windose\",\n                productVersion: \"1.4.0\",\n                showBanner: unityShowBanner,\n            };\n\n            // By default, Unity keeps WebGL canvas render target size matched with\n            // the DOM size of the canvas element (scaled by window.devicePixelRatio)\n            // Set this to false if you want to decouple this synchronization from\n            // happening inside the engine, and you would instead like to size up\n            // the canvas DOM size and WebGL render target sizes yourself.\n            // config.matchWebGLToCanvasSize = false;\n\n            if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {\n                // Mobile device style: fill the whole browser client area with the game canvas:\n\n                var meta = document.createElement('meta');\n                meta.name = 'viewport';\n                meta.content = 'width=device-width, height=device-height, initial-scale=1.0, user-scalable=no, shrink-to-fit=yes';\n                document.getElementsByTagName('head')[0].appendChild(meta);\n                container.className = \"unity-mobile\";\n                canvas.className = \"unity-mobile\";\n\n                // To lower canvas resolution on mobile devices to gain some\n                // performance, uncomment the following line:\n                // config.devicePixelRatio = 1;\n\n\n            }\n\n            loadingBar.classList.remove(\"hidden\");\n            loadingBar.style.display = \"flex\";\n            loadingBar.style.visibility = \"visible\";\n            progressBarFull.classList.add(\"indeterminate\");\n            progressBarFull.style.width = \"40%\";\n\n            var script = document.createElement(\"script\");\n            script.src = loaderUrl;\n            const getFullscreenElement = () => (\n                document.fullscreenElement ||\n                document.webkitFullscreenElement ||\n                document.mozFullScreenElement ||\n                document.msFullscreenElement\n            );\n\n            const FRAME_BAR_HEIGHT = 85;\n\n            const adjustFrameSize = () => {\n                let frameEl = null;\n                try {\n                    frameEl = window.frameElement;\n                } catch (err) {\n                    frameEl = null;\n                }\n                if (!frameEl) return;\n                if (getFullscreenElement() === canvas) {\n                    frameEl.style.height = \"100%\";\n                    frameEl.style.maxHeight = \"100%\";\n                    return;\n                }\n                frameEl.style.height = \"calc(100% - \" + FRAME_BAR_HEIGHT + \"px)\";\n                frameEl.style.maxHeight = \"calc(100% - \" + FRAME_BAR_HEIGHT + \"px)\";\n            };\n\n            const updateLayout = () => {\n                adjustFrameSize();\n                if (getFullscreenElement() === canvas) {\n                    canvas.style.margin = \"0\";\n                    canvas.style.width = \"100%\";\n                    canvas.style.height = \"100%\";\n                    return;\n                }\n                canvas.style.margin = \"0\";\n                const rect = container.getBoundingClientRect();\n                const height = Math.max(0, rect.height);\n                const width = Math.max(0, rect.width);\n                if (!height || !width) {\n                    canvas.style.width = \"0px\";\n                    canvas.style.height = \"0px\";\n                    return;\n                }\n                canvas.style.width = width + \"px\";\n                canvas.style.height = height + \"px\";\n            };\n\n            const resizeCanvas = () => {\n                updateLayout();\n            };\n\n            window.addEventListener(\"resize\", resizeCanvas);\n            document.addEventListener(\"fullscreenchange\", updateLayout);\n            document.addEventListener(\"webkitfullscreenchange\", updateLayout);\n            if (window.visualViewport) {\n                window.visualViewport.addEventListener(\"resize\", updateLayout);\n                window.visualViewport.addEventListener(\"scroll\", updateLayout);\n            }\n            resizeCanvas();\n\n            const startUnity = () => {\n                const splashStart = Date.now();\n                let loadingHidden = false;\n                const updateProgress = (progress) => {\n                    const pct = Math.max(8, Math.min(100, Math.round(progress * 100)));\n                    if (!progressBarFull.classList.contains(\"indeterminate\")) {\n                        progressBarFull.style.width = pct + \"%\";\n                    }\n                };\n\n                const hideLoading = () => {\n                    if (loadingHidden) return;\n                    const elapsed = Date.now() - splashStart;\n                    if (elapsed \u003c 500) {\n                        setTimeout(hideLoading, 500 - elapsed);\n                        return;\n                    }\n                    loadingHidden = true;\n                    progressBarFull.classList.remove(\"indeterminate\");\n                    progressBarFull.style.width = \"100%\";\n                    loadingBar.classList.add(\"hidden\");\n                    loadingBar.style.display = \"none\";\n                    loadingBar.style.visibility = \"hidden\";\n                };\n\n                createUnityInstance(canvas, config, (progress) => {\n                    updateProgress(progress);\n                }).then((unityInstance) => {\n                    updateProgress(1);\n                    hideLoading();\n                }).catch((message) => {\n                    hideLoading();\n                    alert(message);\n                });\n            };\n\n            script.onload = startUnity;\n            if (typeof createUnityInstance === \"function\") {\n                startUnity();\n            }\n\n            document.body.appendChild(script);\n\n        })();\n    \u003c/script>\n\u003c/body>\n\n\u003c/html>\n\u003cstyle>\nhtml,body { margin:0; }\n#loading-text, #loading-textt { font:16px/1.5 system-ui !important; -webkit-text-fill-color:currentColor !important; -webkit-text-stroke:0 !important; animation:none !important; background:none !important; }\n\u003c/style>\n\u003cscript>\nwindow.addEventListener('unhandledrejection', () => {\n const message=document.createElement('p');\n message.textContent='Game could not load. Use Restart or try again later.';\n message.style.cssText='position:fixed;bottom:12px;left:12px;right:12px;padding:12px;background:#fff;color:#222;font:14px sans-serif;z-index:99999';\n document.body.appendChild(message);\n}, {once:true});\n\u003c/script>\n"}