{"html": "\u003c!-- Entry adapter from https://github.com/web-ports/hollow-knight-silksong. Runtime and game assets remain upstream. -->\n\u003c!DOCTYPE html>\n\u003chtml lang=\"en-us\">\n  \u003chead>\n\u003cscript>// Sandboxed game runtimes use session-only storage, never the portfolio's storage.\n// These adapters implement the standard APIs without granting origin access.\n(() => {\n  const memoryStorage = () => {\n    const entries = new Map();\n    return {\n      get length() { return entries.size; },\n      key(index) { return [...entries.keys()][index] ?? null; },\n      getItem(key) { return entries.get(String(key)) ?? null; },\n      setItem(key, value) { entries.set(String(key), String(value)); },\n      removeItem(key) { entries.delete(String(key)); },\n      clear() { entries.clear(); },\n    };\n  };\n  for (const name of ['localStorage', 'sessionStorage']) {\n    try { void window[name]; }\n    catch { Object.defineProperty(window, name, { value: memoryStorage() }); }\n  }\n  try { void window.caches; }\n  catch {\n    const stores = new Map();\n    const keyOf = (request) => new URL(typeof request === 'string' ? request : request.url, document.baseURI).href;\n    Object.defineProperty(window, 'caches', { value: {\n      async open(name) {\n        if (!stores.has(name)) {\n          const entries = new Map();\n          stores.set(name, {\n            async match(request) { return entries.get(keyOf(request))?.clone(); },\n            async put(request, response) { entries.set(keyOf(request), response.clone()); },\n            async delete(request) { return entries.delete(keyOf(request)); },\n            async keys() { return [...entries.keys()].map(url => new Request(url)); },\n          });\n        }\n        return stores.get(name);\n      },\n      async match(request) {\n        for (const cache of stores.values()) {\n          const response = await cache.match(request);\n          if (response) return response;\n        }\n      },\n      async delete(name) { return stores.delete(name); },\n      async keys() { return [...stores.keys()]; },\n    } });\n  }\n})();\n\u003c/script>\n    \u003cbase href=\"https://cdn.jsdelivr.net/gh/web-ports/hollow-knight-silksong@bcbe014765f2f6ca4b1d82ac25755a0299a600ab/\">\n    \u003cmeta charset=\"utf-8\">\n    \u003cmeta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n    \u003ctitle>Unity Web Player | Hollow Knight SilkSong\u003c/title>\n    \u003clink rel=\"shortcut icon\" href=\"TemplateData/favicon.ico\">\n    \u003clink rel=\"stylesheet\" href=\"TemplateData/style.css\">\n  \u003c/head>\n  \u003cbody>\n    \u003cdiv id=\"loading-text\" style=\"color: white; font-size: 48px; font-family: cursive; text-align: center; margin-top: 20px;\"> LOADING...\u003c/div>\n    \u003cdiv id=\"unity-container\">\n      \u003ccanvas id=\"unity-canvas\" width=960 height=600 tabindex=\"-1\">\u003c/canvas>\n      \u003cdiv id=\"unity-loading-bar\">\n        \u003cdiv id=\"unity-logo\">\u003c/div>\n        \u003cdiv id=\"unity-progress-bar-empty\">\n          \u003cdiv id=\"unity-progress-bar-full\">\u003c/div>\n        \u003c/div>\n      \u003c/div>\n      \u003cdiv id=\"unity-warning\"> \u003c/div>\n    \u003c/div>\n    \u003cscript src=\"jszip.js\">\u003c/script>\n\n\u003cscript>\nconst loadingText = document.querySelector(\"#loading-text\");\nconst CACHE_NAME = \"hksilksongcache-v2\"; // bump version if needed\n\n/* ================= FETCH OVERRIDE ================= */\nconst originalFetch = window.fetch;\n\nwindow.fetch = async function(resource, options) {\n  let url = typeof resource === \"string\" ? resource : resource.url;\n  let cleanPath = url.split(\"/\").pop();\n\n  const cache = await caches.open(CACHE_NAME);\n\n  const cachedResponse = await cache.match(cleanPath);\n  if (cachedResponse) {\n    return cachedResponse;\n  }\n\n  return originalFetch(resource, options);\n};\n\n/* ================= CACHE CHECK ================= */\nasync function isCached() {\n  const cache = await caches.open(CACHE_NAME);\n  const done = await cache.match(\"CACHE_COMPLETE\");\n  return !!done;\n}\n\nasync function cleanupOldCaches() {\n  const cacheNames = await caches.keys();\n\n  await Promise.all(\n    cacheNames.map(name => {\n      if (name !== CACHE_NAME && name.includes(\"hksilksong\")) {\n        console.log(\"Deleting old cache:\", name);\n        return caches.delete(name);\n      }\n    })\n  );\n}\n\n/* ================= UNZIP ================= */\nasync function unzipAndStore(zipBlob) {\n  if (!zipBlob) {\n    throw new Error(\"ZIP is missing\");\n  }\n\n  loadingText.textContent = \"EXTRACTING ASSETS...\";\n\n  const zip = await JSZip.loadAsync(zipBlob);\n  const files = Object.values(zip.files).filter(f => !f.dir);\n  const total = files.length;\n\n  const cache = await caches.open(CACHE_NAME);\n\n  let processed = 0;\n  const batchSize = 10;\n\n  for (let i = 0; i \u003c files.length; i += batchSize) {\n    const batch = files.slice(i, i + batchSize);\n\n    await Promise.all(batch.map(async (file) => {\n      try {\n        const blob = await file.async(\"blob\");\n        await cache.put(file.name, new Response(blob));\n      } catch (e) {\n        console.error(\"Failed:\", file.name, e);\n      }\n\n      processed++;\n      loadingText.textContent =\n        `EXTRACTING ASSETS... (${processed}/${total})`;\n    }));\n\n    await new Promise(r => setTimeout(r, 0));\n  }\n\n  // ✅ mark cache complete\n  await cache.put(\"CACHE_COMPLETE\", new Response(\"ok\"));\n\n  console.log(\"Cache complete\");\n}\n\n/* ================= DOWNLOAD ================= */\nlet loadedBytes = 0;\n\nasync function fetchWithProgress(url) {\n  const response = await originalFetch(url);\n\n  if (!response.ok) {\n    throw new Error(\"Failed to fetch: \" + url);\n  }\n\n  const reader = response.body.getReader();\n  let chunks = [];\n  let received = 0;\n\n  while (true) {\n    const { done, value } = await reader.read();\n    if (done) break;\n\n    received += value.length;\n    loadedBytes += value.length;\n    chunks.push(value);\n\n    let mbDone = (loadedBytes / (1024 * 1024)).toFixed(2);\n    let mbTotal = '1986.64';\n\n    loadingText.textContent =\n      `DOWNLOADING ASSETS... (${mbDone} MB / ${mbTotal} MB)`;\n  }\n\n  let fullBuffer = new Uint8Array(received);\n  let offset = 0;\n\n  for (let chunk of chunks) {\n    fullBuffer.set(chunk, offset);\n    offset += chunk.length;\n  }\n\n  return fullBuffer.buffer;\n}\n\n/* ================= MERGE ================= */\nasync function mergeFiles(parts) {\n  console.log(\"Downloading parts:\", parts.length);\n\n  const buffers = await Promise.all(\n    parts.map(part => fetchWithProgress(part))\n  );\n\n  return new Blob(buffers);\n}\n\n/* ================= UTIL ================= */\nfunction getParts(file, start, end) {\n  let parts = [];\n  for (let i = start; i \u003c= end; i++) {\n    parts.push(file + \".part\" + i);\n  }\n  return parts;\n}\n\n/* ================= MAIN ================= */\n(async () => {\n  try {\n    await cleanupOldCaches(); \n    if (!(await isCached())) {\n      loadingText.textContent = \"DOWNLOADING ASSETS...\";\n\n      const webglzip = await mergeFiles(\n        getParts(\"StreamingAssets/aa/WebGL.zip\", 1, 100)\n      );\n\n      await unzipAndStore(webglzip);\n    } else {\n      loadingText.textContent = \"LOADING FROM CACHE...\";\n    }\n\n    /* ================= UNITY START ================= */\n    const canvas = document.querySelector(\"#unity-canvas\");\n    const loadingBar = document.querySelector(\"#unity-loading-bar\");\n    const progressBarFull = document.querySelector(\"#unity-progress-bar-full\");\n    const warningBanner = document.querySelector(\"#unity-warning\");\n\n    function unityShowBanner(msg, type) {\n      function update() {\n        warningBanner.style.display =\n          warningBanner.children.length ? 'block' : 'none';\n      }\n\n      let div = document.createElement('div');\n      div.innerHTML = msg;\n      warningBanner.appendChild(div);\n\n      if (type == 'error') {\n        div.style = 'background:red;padding:10px;';\n      } else {\n        if (type == 'warning') {\n          div.style = 'background:yellow;padding:10px;';\n        }\n        setTimeout(() => {\n          warningBanner.removeChild(div);\n          update();\n        }, 5000);\n      }\n\n      update();\n    }\n\n    const buildUrl = \"Build\";\n\n    const config = {\n      dataUrl: buildUrl + \"/w-pt.data.unityweb\",\n      frameworkUrl: buildUrl + \"/w-pt.framework.js.unityweb\",\n      codeUrl: buildUrl + \"/w-pt.wasm.unityweb\",\n      streamingAssetsUrl: new URL(\"StreamingAssets\", document.baseURI).href,\n      companyName: \"EDUrocks Group, Truffled, GN-Math\",\n      productName: \"Hollow Knight SilkSong\",\n      productVersion: \"1.0\",\n      showBanner: unityShowBanner,\n    };\n\n    loadingBar.style.display = \"block\";\n\n    const script = document.createElement(\"script\");\n    script.src = \"https://cdn.jsdelivr.net/gh/web-ports/hollow-knight-silksong@bcbe014765f2f6ca4b1d82ac25755a0299a600ab/Build/w-pt.loader.js\";\n\n    script.onload = () => {\n      createUnityInstance(canvas, config, (progress) => {\n        progressBarFull.style.width = (progress * 100) + \"%\";\n      })\n      .then(() => {\n        loadingBar.remove();\n        loadingText.remove();\n      })\n      .catch(alert);\n    };\n\n    document.body.appendChild(script);\n\n  } catch (err) {\n    console.error(err);\n    loadingText.textContent = \"ERROR: \" + err.message;\n  }\n})();\n\u003c/script>\n  \u003c/body>\n\u003c/html>\n\n\u003cstyle>\nhtml,body { margin:0; background:#111; }\n#loading-text { font:16px/1.5 system-ui !important; color:#fff !important; background:#111 !important; -webkit-text-fill-color:#fff !important; -webkit-text-stroke:0 !important; animation:none !important; }\n\u003c/style>\n\u003cscript>\nwindow.addEventListener('unhandledrejection', () => {\n const message=document.createElement('p');\n message.textContent='Game could not load. Use Restart or try again later.';\n message.style.cssText='position:fixed;bottom:12px;left:12px;right:12px;padding:12px;background:#fff;color:#222;font:14px sans-serif;z-index:99999';\n document.body.appendChild(message);\n}, {once:true});\n\u003c/script>\n"}