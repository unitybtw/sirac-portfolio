{"html": "\u003c!-- Entry adapter from https://github.com/web-ports/celeste. Game runtime/assets remain upstream. -->\n\u003c!doctype html>\n\u003c!--  Licensed to the .NET Foundation under one or more agreements. -->\n\u003c!-- The .NET Foundation licenses this file to you under the MIT license. -->\n\u003chtml>\n\n\u003chead>\n    \u003cscript>// Sandboxed game runtimes use session-only storage, never the portfolio's storage.\n// These adapters implement the standard APIs without granting origin access.\n(() => {\n  const memoryStorage = () => {\n    const entries = new Map();\n    return {\n      get length() { return entries.size; },\n      key(index) { return [...entries.keys()][index] ?? null; },\n      getItem(key) { return entries.get(String(key)) ?? null; },\n      setItem(key, value) { entries.set(String(key), String(value)); },\n      removeItem(key) { entries.delete(String(key)); },\n      clear() { entries.clear(); },\n    };\n  };\n  for (const name of ['localStorage', 'sessionStorage']) {\n    try { void window[name]; }\n    catch { Object.defineProperty(window, name, { value: memoryStorage() }); }\n  }\n  try { void window.caches; }\n  catch {\n    const stores = new Map();\n    const keyOf = (request) => new URL(typeof request === 'string' ? request : request.url, document.baseURI).href;\n    Object.defineProperty(window, 'caches', { value: {\n      async open(name) {\n        if (!stores.has(name)) {\n          const entries = new Map();\n          stores.set(name, {\n            async match(request) { return entries.get(keyOf(request))?.clone(); },\n            async put(request, response) { entries.set(keyOf(request), response.clone()); },\n            async delete(request) { return entries.delete(keyOf(request)); },\n            async keys() { return [...entries.keys()].map(url => new Request(url)); },\n          });\n        }\n        return stores.get(name);\n      },\n      async match(request) {\n        for (const cache of stores.values()) {\n          const response = await cache.match(request);\n          if (response) return response;\n        }\n      },\n      async delete(name) { return stores.delete(name); },\n      async keys() { return [...stores.keys()]; },\n    } });\n  }\n})();\n\u003c/script>\n    \u003cbase href=\"https://cdn.jsdelivr.net/gh/web-ports/celeste@4f043a5ce121b74dc54ce56d74f213a2eeea6b4e/\">\n    \u003ctitle>CelesteWasm\u003c/title>\n    \u003cmeta charset=\"UTF-8\" />\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\n    \u003clink rel=\"icon\" type=\"image/x-icon\" href=\"assets/app.ico\" />\n    \u003clink rel=\"prefetch\" id=\"mountainsrc\" href=\"assets/mountain.png\">\n    \u003clink rel=\"stylesheet\" href=\"styles.css\" />\n    \u003clink\n        href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=Inter:wght@100..900&family=Material+Symbols+Rounded&display=swap\"\n        rel=\"stylesheet\" />\n\n    \u003cscript src=\"cfg.js\">\u003c/script>\n    \u003cscript src=\"data.js\">\u003c/script>\n    \u003cscript type=\"module\" src=\"bundle.js\">\u003c/script>\n\u003c/head>\n\n\u003cbody>\n    \u003cdiv id=\"loading-textt\" style=\"color: black; font-size: 48px; font-family: cursive; text-align: center; margin-top: 20px;\">LOADING DOT.NET...\u003c/div>\n\u003c/body>\n\n\u003c/html>\n\n\u003cscript>\nwindow.addEventListener('unhandledrejection', () => {\n  const message = document.createElement('p');\n  message.textContent = 'Game could not load. Check your connection and use Restart to try again.';\n  message.style.cssText = 'position:fixed;bottom:12px;left:12px;right:12px;padding:12px;background:#fff;color:#222;font:14px sans-serif;z-index:99999';\n  document.body.appendChild(message);\n}, {once:true});\n\u003c/script>\n\u003cstyle>\nhtml, body { margin:0; background:#111; }\n#loading-text, #loading-textt { position:fixed; inset:0; margin:0 !important; display:grid; place-content:center; padding:24px; font:16px/1.5 system-ui !important; color:#fff !important; background:#111 !important; -webkit-text-fill-color:#fff !important; -webkit-text-stroke:0 !important; animation:none !important; z-index:5; }\n\u003c/style>"}