{"html": "\u003c!-- Entry adapter from https://github.com/web-ports/srb2. Game runtime and assets remain upstream. -->\n\u003c!doctypehtml>\n\t\u003chtml lang=en>\n\n\t\u003chead>\n\u003cscript>// Sandboxed game runtimes use session-only storage, never the portfolio's storage.\n// These adapters implement the standard APIs without granting origin access.\n(() => {\n  const memoryStorage = () => {\n    const entries = new Map();\n    return {\n      get length() { return entries.size; },\n      key(index) { return [...entries.keys()][index] ?? null; },\n      getItem(key) { return entries.get(String(key)) ?? null; },\n      setItem(key, value) { entries.set(String(key), String(value)); },\n      removeItem(key) { entries.delete(String(key)); },\n      clear() { entries.clear(); },\n    };\n  };\n  for (const name of ['localStorage', 'sessionStorage']) {\n    try { void window[name]; }\n    catch { Object.defineProperty(window, name, { value: memoryStorage() }); }\n  }\n  try { void window.caches; }\n  catch {\n    const stores = new Map();\n    const keyOf = (request) => new URL(typeof request === 'string' ? request : request.url, document.baseURI).href;\n    Object.defineProperty(window, 'caches', { value: {\n      async open(name) {\n        if (!stores.has(name)) {\n          const entries = new Map();\n          stores.set(name, {\n            async match(request) { return entries.get(keyOf(request))?.clone(); },\n            async put(request, response) { entries.set(keyOf(request), response.clone()); },\n            async delete(request) { return entries.delete(keyOf(request)); },\n            async keys() { return [...entries.keys()].map(url => new Request(url)); },\n          });\n        }\n        return stores.get(name);\n      },\n      async match(request) {\n        for (const cache of stores.values()) {\n          const response = await cache.match(request);\n          if (response) return response;\n        }\n      },\n      async delete(name) { return stores.delete(name); },\n      async keys() { return [...stores.keys()]; },\n    } });\n  }\n})();\n\u003c/script>\n\u003cbase href=\"https://cdn.jsdelivr.net/gh/web-ports/srb2@f6702b8f077bf7b23a8e40cbbb6c18d4fe061cf8/\">\n\t\t\u003cmeta charset=utf-8>\n\t\t\u003clink rel=\"canonical\" href=\"https://kbhgames.com/game/sonic-robo-blast-2\">\n\t\t\u003cmeta content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\" name=viewport>\n\t\t\u003ctitle>Sonic Robo Blast 2\u003c/title>\n\t\t\u003cscript>\n\t\t\tObject.defineProperty(window, \"devicePixelRatio\", {\n\t\t\t\tvalue: 1,\n\t\t\t\twritable: !1\n\t\t\t})\n\t\t\u003c/script>\n\t\t\u003cstyle>\n\t\t\t* {\n\t\t\t\tmargin: 0;\n\t\t\t\tpadding: 0;\n\t\t\t\tbox-sizing: border-box\n\t\t\t}\n\n\t\t\tbody,\n\t\t\thtml {\n\t\t\t\ttouch-action: none;\n\t\t\t\t-ms-touch-action: none;\n\t\t\t\toverscroll-behavior: none\n\t\t\t}\n\n\t\t\tbody {\n\t\t\t\tbackground: #000;\n\t\t\t\tcolor: #fff;\n\t\t\t\tfont-family: 'Segoe UI', Arial, sans-serif;\n\t\t\t\toverflow: hidden;\n\t\t\t\theight: 100vh;\n\t\t\t\tdisplay: flex;\n\t\t\t\tflex-direction: column;\n\t\t\t\talign-items: center;\n\t\t\t\tjustify-content: center\n\t\t\t}\n\n\t\t\t#loading {\n\t\t\t\ttext-align: center;\n\t\t\t\tpadding: 40px\n\t\t\t}\n\n\t\t\t#loading h2 {\n\t\t\t\tfont-size: 24px;\n\t\t\t\tmargin-bottom: 20px;\n\t\t\t\tcolor: #4af\n\t\t\t}\n\n\t\t\t#loading p {\n\t\t\t\tcolor: #aaa;\n\t\t\t\tmargin-bottom: 15px;\n\t\t\t\tfont-size: 14px\n\t\t\t}\n\n\t\t\t#progress-bar {\n\t\t\t\twidth: 400px;\n\t\t\t\tmax-width: 80vw;\n\t\t\t\theight: 20px;\n\t\t\t\tbackground: #222;\n\t\t\t\tborder-radius: 10px;\n\t\t\t\toverflow: hidden;\n\t\t\t\tmargin: 0 auto 10px\n\t\t\t}\n\n\t\t\t#progress-fill {\n\t\t\t\theight: 100%;\n\t\t\t\twidth: 0%;\n\t\t\t\tbackground: linear-gradient(90deg, #07f, #4af);\n\t\t\t\tborder-radius: 10px;\n\t\t\t\ttransition: width .2s\n\t\t\t}\n\n\t\t\t#progress-text {\n\t\t\t\tfont-size: 14px;\n\t\t\t\tcolor: #888\n\t\t\t}\n\n\t\t\t#status-text {\n\t\t\t\tfont-size: 12px;\n\t\t\t\tcolor: #666;\n\t\t\t\tmargin-top: 10px\n\t\t\t}\n\n\t\t\tcanvas {\n\t\t\t\tdisplay: none;\n\t\t\t\toutline: 0;\n\t\t\t\tposition: fixed;\n\t\t\t\ttop: 50%;\n\t\t\t\tleft: 50%;\n\t\t\t\ttransform: translate(-50%, -50%);\n\t\t\t\tobject-fit: contain\n\t\t\t}\n\n\t\t\t#controls {\n\t\t\t\tdisplay: none;\n\t\t\t\tposition: fixed;\n\t\t\t\tbottom: 10px;\n\t\t\t\tright: 10px;\n\t\t\t\tz-index: 100\n\t\t\t}\n\n\t\t\t#controls button {\n\t\t\t\tbackground: rgba(255, 255, 255, .15);\n\t\t\t\tborder: 1px solid rgba(255, 255, 255, .3);\n\t\t\t\tcolor: #fff;\n\t\t\t\tpadding: 8px 14px;\n\t\t\t\tmargin-left: 5px;\n\t\t\t\tcursor: pointer;\n\t\t\t\tborder-radius: 4px;\n\t\t\t\tfont-size: 13px\n\t\t\t}\n\n\t\t\t#controls button:hover {\n\t\t\t\tbackground: rgba(255, 255, 255, .25)\n\t\t\t}\n\n\t\t\t#error {\n\t\t\t\tdisplay: none;\n\t\t\t\ttext-align: center;\n\t\t\t\tpadding: 40px\n\t\t\t}\n\n\t\t\t#error h2 {\n\t\t\t\tcolor: #f44;\n\t\t\t\tmargin-bottom: 10px\n\t\t\t}\n\n\t\t\t#error pre {\n\t\t\t\tbackground: #111;\n\t\t\t\tpadding: 15px;\n\t\t\t\tborder-radius: 8px;\n\t\t\t\ttext-align: left;\n\t\t\t\tmax-width: 600px;\n\t\t\t\tmargin: 10px auto;\n\t\t\t\toverflow-x: auto;\n\t\t\t\tfont-size: 12px;\n\t\t\t\tcolor: #f88\n\t\t\t}\n\n\t\t\t#save-status {\n\t\t\t\tdisplay: none;\n\t\t\t\tposition: fixed;\n\t\t\t\ttop: 10px;\n\t\t\t\tright: 10px;\n\t\t\t\tbackground: rgba(0, 180, 0, .8);\n\t\t\t\tcolor: #fff;\n\t\t\t\tpadding: 8px 16px;\n\t\t\t\tborder-radius: 4px;\n\t\t\t\tfont-size: 13px;\n\t\t\t\tz-index: 200;\n\t\t\t\ttransition: opacity .5s\n\t\t\t}\n\n\t\t\t#touch-controls {\n\t\t\t\tdisplay: none;\n\t\t\t\tposition: fixed;\n\t\t\t\ttop: 0;\n\t\t\t\tleft: 0;\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\tz-index: 50;\n\t\t\t\tpointer-events: none;\n\t\t\t\ttouch-action: none;\n\t\t\t\tuser-select: none;\n\t\t\t\t-webkit-user-select: none\n\t\t\t}\n\n\t\t\t#touch-controls .touch-btn {\n\t\t\t\tposition: absolute;\n\t\t\t\tpointer-events: auto;\n\t\t\t\twidth: 56px;\n\t\t\t\theight: 56px;\n\t\t\t\tborder-radius: 50%;\n\t\t\t\tbackground: rgba(255, 255, 255, .13);\n\t\t\t\tborder: 2px solid rgba(255, 255, 255, .25);\n\t\t\t\tcolor: rgba(255, 255, 255, .6);\n\t\t\t\tfont-size: 18px;\n\t\t\t\tfont-weight: 700;\n\t\t\t\tdisplay: flex;\n\t\t\t\talign-items: center;\n\t\t\t\tjustify-content: center;\n\t\t\t\ttouch-action: none;\n\t\t\t\tuser-select: none;\n\t\t\t\t-webkit-user-select: none\n\t\t\t}\n\n\t\t\t#touch-controls .touch-btn.active {\n\t\t\t\tbackground: rgba(255, 255, 255, .3);\n\t\t\t\tborder-color: rgba(255, 255, 255, .5)\n\t\t\t}\n\n\t\t\t#touch-controls .touch-btn.btn-esc {\n\t\t\t\twidth: 40px;\n\t\t\t\theight: 40px;\n\t\t\t\tfont-size: 12px\n\t\t\t}\n\n\t\t\t#dpad-container {\n\t\t\t\tposition: absolute;\n\t\t\t\tbottom: 30px;\n\t\t\t\tleft: 20px;\n\t\t\t\twidth: 164px;\n\t\t\t\theight: 164px\n\t\t\t}\n\n\t\t\t#action-container {\n\t\t\t\tposition: absolute;\n\t\t\t\tbottom: 30px;\n\t\t\t\tright: 20px;\n\t\t\t\twidth: 164px;\n\t\t\t\theight: 164px\n\t\t\t}\n#loading-text {\n  font-weight: bold;\n  background: linear-gradient(\n    270deg,\n    #ff0000,\n    #ff7f00,\n    #ffff00,\n    #00ff00,\n    #0000ff,\n    #4b0082,\n    #8f00ff\n  );\n  background-size: 400% 400%;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  animation: rainbow 3s ease infinite;\n}\n\n@keyframes rainbow {\n  0% { background-position: 0% 50%; }\n  50% { background-position: 100% 50%; }\n  100% { background-position: 0% 50%; }\n}\n\t\t\u003c/style>\n\t\u003c/head>\n\n\t\u003cbody>\n\u003cdiv id=\"loading-text\"\n    style=\"color: white; font-size: 48px; font-family: cursive; text-align: center; margin-top: 20px;\"> LOADING...\n  \u003c/div>\n\t\t\u003cdiv id=loading>\n\t\t\t\u003ch2>Sonic Robo Blast 2\u003c/h2>\n\t\t\t\u003cp>Loading game data...\u003c/p>\n\t\t\t\u003cdiv id=progress-bar>\n\t\t\t\t\u003cdiv id=progress-fill>\u003c/div>\n\t\t\t\u003c/div>\n\t\t\t\u003cdiv id=progress-text>Initializing...\u003c/div>\n\t\t\t\u003cdiv id=status-text>\u003c/div>\n\t\t\u003c/div>\n\t\t\u003cdiv id=error>\n\t\t\t\u003ch2>Error\u003c/h2>\n\t\t\t\u003cpre id=error-text>\u003c/pre>\n\t\t\t\u003cp>Check the browser console for details.\u003c/p>\n\t\t\u003c/div>\u003ccanvas id=canvas oncontextmenu=event.preventDefault() tabindex=-1>\u003c/canvas>\n\t\t\u003cdiv id=controls>\n\t\t\t\u003cdiv id=saves-menu style=position:relative;display:inline-block>\u003cbutton onclick='var m=document.getElementById(\"saves-dropdown\");m.style.display=\"block\"===m.style.display?\"none\":\"block\"'>Save\u003c/button>\n\t\t\t\t\u003cdiv id=saves-dropdown style=display:none;position:absolute;bottom:100%;right:0;margin-bottom:4px>\u003cbutton onclick='exportSaves(),document.getElementById(\"saves-dropdown\").style.display=\"none\"'>Export\u003c/button> \u003cbutton onclick='document.getElementById(\"import-file\").click(),document.getElementById(\"saves-dropdown\").style.display=\"none\"'>Import\u003c/button>\u003c/div>\n\t\t\t\u003c/div>\u003cinput accept=.json id=import-file onchange=importSaves(event) style=display:none type=file>\n\t\t\u003c/div>\n\t\t\u003cdiv id=save-status>\u003c/div>\n\t\t\u003cdiv id=touch-controls>\n\t\t\t\u003cdiv style=top:10px;left:10px class=\"touch-btn btn-esc\" data-key=27>Esc\u003c/div>\n\t\t\t\u003cdiv id=dpad-container>\n\t\t\t\t\u003cdiv style=left:54px;top:0 class=touch-btn data-key=230>▲\u003c/div>\n\t\t\t\t\u003cdiv style=left:0;top:54px class=touch-btn data-key=233>◀\u003c/div>\n\t\t\t\t\u003cdiv style=left:108px;top:54px class=touch-btn data-key=235>▶\u003c/div>\n\t\t\t\t\u003cdiv style=left:54px;top:108px class=touch-btn data-key=238>▼\u003c/div>\n\t\t\t\u003c/div>\n\t\t\t\u003cdiv id=action-container>\n\t\t\t\t\u003cdiv style=left:54px;top:0 class=touch-btn data-key=97>A\u003c/div>\n\t\t\t\t\u003cdiv style=left:0;top:54px class=touch-btn data-key=32>★\u003c/div>\n\t\t\t\t\u003cdiv style=left:108px;top:54px class=touch-btn data-key=13>⏎\u003c/div>\n\t\t\t\t\u003cdiv style=left:54px;top:108px class=touch-btn data-key=115>S\u003c/div>\n\t\t\t\u003c/div>\n\t\t\u003c/div>\n\t\t\u003cscript>\nvar loadingText = document.querySelector(\"#loading-text\");\n    let totalBytes = 0;\n    let loadedBytes = 0;\n\n    async function fetchWithProgress(url) {\n      const response = await fetch(url);\n      const reader = response.body.getReader();\n      let chunks = [];\n      let received = 0;\n      while (true) {\n        const {\n          done,\n          value\n        } = await reader.read();\n        if (done) break;\n        received += value.length;\n        loadedBytes += value.length;\n        chunks.push(value);\n        let mbDone = (loadedBytes / (1024 * 1024)).toFixed(2);\n        let mbTotal = '162.41';\n        loadingText.textContent = `LOADING... ${mbDone} MB / ${mbTotal} MB`;\n      }\n      let fullBuffer = new Uint8Array(received);\n      let offset = 0;\n      for (let chunk of chunks) {\n        fullBuffer.set(chunk, offset);\n        offset += chunk.length;\n      }\n      return fullBuffer.buffer;\n    }\n\n    async function mergeFiles(fileParts, cacheKey) {\n      const cache = await caches.open(\"srb2-cache\");\n      const cachedResponse = await cache.match(cacheKey);\n      if (cachedResponse) {\n        const blob = await cachedResponse.blob();\n        return URL.createObjectURL(blob);\n      }\n      const buffers = await Promise.all(\n        fileParts.map(part => fetchWithProgress(part))\n      );\n      const mergedBlob = new Blob(buffers);\n      const response = new Response(mergedBlob);\n      await cache.put(cacheKey, response);\n      return URL.createObjectURL(mergedBlob);\n    }\n\n    function getParts(file, start, end) {\n      let parts = [];\n      for (let i = start; i \u003c= end; i++) {\n        parts.push(file + \".part\" + i);\n      }\n      return parts;\n    }\n    (async () => {\n      const [dataUrl] = await Promise.all([\n        m