{"html": "\u003c!-- Entry adapter from https://github.com/web-ports/slendytubbies. Game runtime and assets remain upstream. -->\n\u003c!DOCTYPE html>\n\u003chtml lang=\"en-us\">\n  \u003chead>\n\u003cscript>// Sandboxed game runtimes use session-only storage, never the portfolio's storage.\n// These adapters implement the standard APIs without granting origin access.\n(() => {\n  const memoryStorage = () => {\n    const entries = new Map();\n    return {\n      get length() { return entries.size; },\n      key(index) { return [...entries.keys()][index] ?? null; },\n      getItem(key) { return entries.get(String(key)) ?? null; },\n      setItem(key, value) { entries.set(String(key), String(value)); },\n      removeItem(key) { entries.delete(String(key)); },\n      clear() { entries.clear(); },\n    };\n  };\n  for (const name of ['localStorage', 'sessionStorage']) {\n    try { void window[name]; }\n    catch { Object.defineProperty(window, name, { value: memoryStorage() }); }\n  }\n  try { void window.caches; }\n  catch {\n    const stores = new Map();\n    const keyOf = (request) => new URL(typeof request === 'string' ? request : request.url, document.baseURI).href;\n    Object.defineProperty(window, 'caches', { value: {\n      async open(name) {\n        if (!stores.has(name)) {\n          const entries = new Map();\n          stores.set(name, {\n            async match(request) { return entries.get(keyOf(request))?.clone(); },\n            async put(request, response) { entries.set(keyOf(request), response.clone()); },\n            async delete(request) { return entries.delete(keyOf(request)); },\n            async keys() { return [...entries.keys()].map(url => new Request(url)); },\n          });\n        }\n        return stores.get(name);\n      },\n      async match(request) {\n        for (const cache of stores.values()) {\n          const response = await cache.match(request);\n          if (response) return response;\n        }\n      },\n      async delete(name) { return stores.delete(name); },\n      async keys() { return [...stores.keys()]; },\n    } });\n  }\n})();\n\u003c/script>\n    \u003cbase href=\"https://cdn.jsdelivr.net/gh/web-ports/slendytubbies@efd9ef91acd1282a9ec4cae5bfd2fadc4f9f07ce/2d/\">\n    \u003cmeta charset=\"utf-8\">\n    \u003cmeta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n    \u003ctitle>Unity WebGL Player | Slendytubbies 2D\u003c/title>\n    \u003cstyle>\n      html, body {\n        background-color: black;\n        margin: 0;\n        padding: 0;\n        overflow: hidden;\n        width: 100%;\n        height: 100%;\n      }\n      body {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n      }\n      canvas {\n        display: block;\n        width: 100vw !important;\n        height: 100vh !important;\n        background: black;\n        outline: none;\n      }\n      #loading-text {\n        position: fixed;\n        top: 20px;\n        left: 0;\n        right: 0;\n        text-align: center;\n        color: white;\n        font-size: 48px;\n        font-family: cursive;\n        font-weight: bold;\n        z-index: 9999;\n        pointer-events: none;\n        background: linear-gradient(\n          270deg,\n          #ff0000,\n          #ff7f00,\n          #ffff00,\n          #00ff00,\n          #0000ff,\n          #4b0082,\n          #8f00ff\n        );\n        background-size: 400% 400%;\n        -webkit-background-clip: text;\n        -webkit-text-fill-color: transparent;\n        background-clip: text;\n        animation: rainbow 3s ease infinite;\n      }\n      @keyframes rainbow {\n        0% { background-position: 0% 50%; }\n        50% { background-position: 100% 50%; }\n        100% { background-position: 0% 50%; }\n      }\n    \u003c/style>\n  \u003c/head>\n  \u003cbody>\n    \u003cdiv id=\"loading-text\">LOADING...\u003c/div>\n    \u003ccanvas class=\"emscripten\" id=\"canvas\" oncontextmenu=\"event.preventDefault()\">\u003c/canvas>\n\n    \u003cscript type=\"text/javascript\">\n      var Module = {\n        TOTAL_MEMORY: 1073741824,\n        errorhandler: null,\n        compatibilitycheck: null,\n        dataUrl: \"Release/Build.data\",\n        codeUrl: \"Release/Build.js\",\n        memUrl: \"Release/Build.mem\"\n      };\n    \u003c/script>\n\n    \u003cscript type=\"text/javascript\">\n      (async function () {\n        const loadingText = document.getElementById(\"loading-text\");\n        const TOTAL_MB = (16.96 + 19.9).toFixed(2);\n        let loadedBytes = 0;\n\n        async function fetchWithProgress(url) {\n          const response = await fetch(url);\n          if (!response.ok) throw new Error(\"Failed to fetch \" + url + \" (\" + response.status + \")\");\n          const reader = response.body.getReader();\n          const chunks = [];\n          let received = 0;\n          while (true) {\n            const { done, value } = await reader.read();\n            if (done) break;\n            received += value.length;\n            loadedBytes += value.length;\n            chunks.push(value);\n            const mbDone = (loadedBytes / (1024 * 1024)).toFixed(2);\n            loadingText.textContent = `LOADING... ${mbDone} MB / ${TOTAL_MB} MB`;\n          }\n          const fullBuffer = new Uint8Array(received);\n          let offset = 0;\n          for (const chunk of chunks) {\n            fullBuffer.set(chunk, offset);\n            offset += chunk.length;\n          }\n          return fullBuffer.buffer;\n        }\n\n        async function mergeFiles(fileParts, cacheKey) {\n          const cache = await caches.open(\"st2d-cache\");\n          const cachedResponse = await cache.match(cacheKey);\n          if (cachedResponse) {\n            const blob = await cachedResponse.blob();\n            loadingText.textContent = `LOADING... (cached)`;\n            return URL.createObjectURL(blob);\n          }\n          const buffers = await Promise.all(fileParts.map(part => fetchWithProgress(part)));\n          const mergedBlob = new Blob(buffers);\n          const response = new Response(mergedBlob);\n          await cache.put(cacheKey, response);\n          return URL.createObjectURL(mergedBlob);\n        }\n\n        function getParts(file, start, end) {\n          const parts = [];\n          for (let i = start; i \u003c= end; i++) {\n            parts.push(file + \".part\" + i);\n          }\n          return parts;\n        }\n\n        try {\n          const datagzurl = await mergeFiles(getParts(\"Release/Build.datagz\", 1, 2), \"Build.datagz\");\n\n          const originalOpen = XMLHttpRequest.prototype.open;\n          XMLHttpRequest.prototype.open = function (method, url, ...rest) {\n            if (typeof url === \"string\" && url.indexOf(\"Build.datagz\") !== -1) {\n              url = datagzurl;\n            }\n            return originalOpen.call(this, method, url, ...rest);\n          };\n\n          const originalFetch = window.fetch;\n          window.fetch = function (input, init) {\n            if (typeof input === \"string\" && input.indexOf(\"Build.datagz\") !== -1) {\n              input = datagzurl;\n            } else if (input && typeof input === \"object\" && input.url && input.url.indexOf(\"Build.datagz\") !== -1) {\n              input = new Request(datagzurl, input);\n            }\n            return originalFetch.call(this, input, init);\n          };\n\n          await new Promise((resolve, reject) => {\n            const s = document.createElement(\"script\");\n            s.src = \"Release/UnityLoader.js\";\n            s.onload = resolve;\n            s.onerror = () => reject(new Error(\"Failed to load Release/UnityLoader.js\"));\n            document.body.appendChild(s);\n          });\n\n          const hideWhenReady = () => {\n            if (loadingText && loadingText.parentNode) {\n              loadingText.parentNode.removeChild(loadingText);\n            }\n          };\n          setTimeout(hideWhenReady, 4000);\n        } catch (err) {\n          console.error(err);\n          loadingText.textContent = \"ERROR: \" + err.message;\n          loadingText.style.background = \"none\";\n          loadingText.style.webkitTextFillColor = \"red\";\n          loadingText.style.color = \"red\";\n        }\n      })();\n    \u003c/script>\n  \u003c/body>\n\u003c/html>\n\u003cstyle>\nhtml,body { margin:0; }\n#loading-text, #loading-textt { font:16px/1.5 system-ui !important; -webkit-text-fill-color:currentColor !important; -webkit-text-stroke:0 !important; animation:none !important; background:none !important; }\n\u003c/style>\n\u003cscript>\nwindow.addEventListener('unhandledrejection', () => {\n const message=document.createElement('p');\n message.textContent='Game could not load. Use Restart or try again later.';\n message.style.cssText='position:fixed;bottom:12px;left:12px;right:12px;padding:12px;background:#fff;color:#222;font:14px sans-serif;z-index:99999';\n document.body.appendChild(message);\n}, {once:true});\n\u003c/script>\n"}