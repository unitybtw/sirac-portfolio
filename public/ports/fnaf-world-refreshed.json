{"html": "\u003c!-- Entry adapter from https://github.com/web-ports/fnaf-world-refreshed. Game runtime and assets remain upstream. -->\n\u003c!DOCTYPE html>\n\u003chtml lang=\"en\">\n\n\u003cstyle type=\"text/css\">\n  h1 {\n\t  font-family: Arial, Helvetica, sans-serif;\n\t  color: #F00;\n\t  font-size: x-large;\n  }\n  p {\n\t  font-family: Arial, Helvetica, sans-serif;\n\t  color: #000;\n\t  font-size: small;\n  }\n  body {\n\t  background-color: #FFF;\n      text-align: center;\n      margin: 0;\n      padding: 0;\n  }\n  #bloctxt {\n\t  border-left-width: 5px;\n\t  border-left-style: solid;\n\t  border-left-color: #F00;\n\t  padding-left: 10px;\n\t  position: absolute;\n\t  left: 50%%;\n\t  width: 600px;\n\t  margin-left: -260px\n  }\n\u003c/style>\n\u003chead>\n\u003cscript>// Sandboxed game runtimes use session-only storage, never the portfolio's storage.\n// These adapters implement the standard APIs without granting origin access.\n(() => {\n  const memoryStorage = () => {\n    const entries = new Map();\n    return {\n      get length() { return entries.size; },\n      key(index) { return [...entries.keys()][index] ?? null; },\n      getItem(key) { return entries.get(String(key)) ?? null; },\n      setItem(key, value) { entries.set(String(key), String(value)); },\n      removeItem(key) { entries.delete(String(key)); },\n      clear() { entries.clear(); },\n    };\n  };\n  for (const name of ['localStorage', 'sessionStorage']) {\n    try { void window[name]; }\n    catch { Object.defineProperty(window, name, { value: memoryStorage() }); }\n  }\n  try { void window.caches; }\n  catch {\n    const stores = new Map();\n    const keyOf = (request) => new URL(typeof request === 'string' ? request : request.url, document.baseURI).href;\n    Object.defineProperty(window, 'caches', { value: {\n      async open(name) {\n        if (!stores.has(name)) {\n          const entries = new Map();\n          stores.set(name, {\n            async match(request) { return entries.get(keyOf(request))?.clone(); },\n            async put(request, response) { entries.set(keyOf(request), response.clone()); },\n            async delete(request) { return entries.delete(keyOf(request)); },\n            async keys() { return [...entries.keys()].map(url => new Request(url)); },\n          });\n        }\n        return stores.get(name);\n      },\n      async match(request) {\n        for (const cache of stores.values()) {\n          const response = await cache.match(request);\n          if (response) return response;\n        }\n      },\n      async delete(name) { return stores.delete(name); },\n      async keys() { return [...stores.keys()]; },\n    } });\n  }\n})();\n\u003c/script>\n\u003cbase href=\"https://cdn.jsdelivr.net/gh/web-ports/fnaf-world-refreshed@5ad15720ba66d73ff80d7fa9d7a4cbf4a297e7ae/\">\n  \u003cmeta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n\n  \u003c!-- Enables full-screen on iOS devices -->\n  \u003cmeta name=\"viewport\" content=\"initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, target-densitydpi=device-dpi\" />\n  \u003cmeta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n  \u003cmeta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\" />\n  \u003cmeta name=\"HandheldFriendly\" content=\"true\" />\n\n  \u003ctitle>Clickteam Fusion Developer 2.5+ HTML5 Runtime\u003c/title>\n\n  \t\u003c!-- EXTRASOURCES -->\n    \u003c!-- Loads the Javascript code...-->\n    \u003cscript src=\"src/Runtime.js\">\u003c/script>\n\u003c/head>\n\n\u003cbody>\n\n\u003cdiv style=\"display: inline-block; -webkit-user-select: none; text-align: left;\">\n    \u003ccanvas id=\"MMFCanvas\" width=\"800\" height=\"480\">\n    \tYour browser does not support Canvas.\n    \u003c/canvas>\n\u003c/div>\n\n\u003cscript>\n    // RUNTIMESTART\n    // This is where the HTML5 runtime is actually started\n    window.addEventListener(\"load\", windowLoaded, false);\n    function windowLoaded()\n    {\n        // Calls the runtime\n        // First parameter : name of the canvas element\n        // Second parameter : path to the cch file. Images and sounds must lay beside this file\n        new Runtime(\"MMFCanvas\", \"resources/fnaf-world-refreshed.cch\");\n    }\n    // RUNTIMESTARTEND\n\u003c/script>\n\n\u003c/body>\n\u003c/html>\n\n\u003cstyle>\nhtml,body { margin:0; }\n#loading-text, #loading-textt { font:16px/1.5 system-ui !important; -webkit-text-fill-color:currentColor !important; -webkit-text-stroke:0 !important; animation:none !important; background:none !important; }\n\u003c/style>\n\u003cscript>\nwindow.addEventListener('unhandledrejection', () => {\n const message=document.createElement('p');\n message.textContent='Game could not load. Use Restart or try again later.';\n message.style.cssText='position:fixed;bottom:12px;left:12px;right:12px;padding:12px;background:#fff;color:#222;font:14px sans-serif;z-index:99999';\n document.body.appendChild(message);\n}, {once:true});\n\u003c/script>\n"}